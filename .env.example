# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-PEGA_AQUI_TU_API_KEY
# Modelo principal + alternativa gratuita. Puedes dejar uno solo o separar varios por comas.
OPENROUTER_MODEL=stepfun/step-3.5-flash:free,openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://tu-dominio-o-repositorio.example

# WhatsApp
# ID exacto del grupo, por ejemplo: 1203630XXXXXXXX@g.us
TARGET_GROUP_ID=1203630XXXXXXXX@g.us
# Número del administrador con prefijo internacional, o JID: 535XXXXXXXX@s.whatsapp.net
ADMIN_WHATSAPP_ID=535XXXXXXXX@s.whatsapp.net
# Opcional: grupos adicionales, separados por comas. Si se deja vacío, solo usa TARGET_GROUP_ID.
ALLOWED_GROUP_IDS=

# Supabase (recomendado para memoria, advertencias y sugerencias persistentes)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY

# Servidor y almacenamiento
PORT=3000
TIME_ZONE=America/Havana
AUTH_DIR=/data/auth
# Login por código de vinculación (recomendado). Número del bot con prefijo de país, solo dígitos. Ej: 5351234567
# Con la sesión vacía, abre /pair?token=TU_TOKEN y escribe el código en WhatsApp > Dispositivos vinculados > Vincular con número de teléfono.
PAIRING_PHONE=

# Comportamiento humano (escribiendo..., lectura con retraso, pausas, horas de descanso en hora de Cuba)
HUMANIZE=true
QUIET_HOURS_START=1
QUIET_HOURS_END=7

# Protege /qr y /pair con un token. Déjalo vacío solo durante la primera configuración si tu entorno ya está protegido.
QR_ACCESS_TOKEN=CAMBIA_ESTE_TOKEN_LARGO
LOG_LEVEL=info

# Historial enviado al modelo (20 a 250 mensajes recientes; el resumen se conserva en Supabase)
HISTORY_LIMIT=100
# Ventana en minutos para detectar duplicados exactos del mismo usuario
DUPLICATE_WINDOW_MINUTES=10
